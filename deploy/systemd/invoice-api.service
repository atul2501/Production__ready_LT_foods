[Unit]
Description=LT Foods Invoice Extraction API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=invoice-service
Group=invoice-service
WorkingDirectory=/opt/invoice-service
EnvironmentFile=/opt/invoice-service/.env
ExecStart=/opt/invoice-service/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
