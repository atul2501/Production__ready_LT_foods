[Unit]
Description=Run LT Foods invoice retention cleanup daily

[Timer]
OnCalendar=daily
# Catches up a missed run (server was off/rebooted) on next boot instead of silently
# skipping it - a plain `while True: sleep(24h)` process has no equivalent for this.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
