[Unit]
Description=LT Foods invoice retention cleanup (delete completed jobs/PDFs older than RETENTION_DAYS)
After=network.target postgresql.service

[Service]
Type=oneshot
User=invoice-service
Group=invoice-service
WorkingDirectory=/opt/invoice-service
EnvironmentFile=/opt/invoice-service/.env
ExecStart=/opt/invoice-service/.venv/bin/python -m app.worker.retention
