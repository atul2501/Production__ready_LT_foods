[Unit]
Description=LT Foods Invoice Extraction Email Ingest (IMAP mailbox watcher)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=invoice-service
Group=invoice-service
WorkingDirectory=/opt/invoice-service
EnvironmentFile=/opt/invoice-service/.env
ExecStart=/opt/invoice-service/.venv/bin/python email_ingest_main.py
Restart=on-failure
RestartSec=5
# One ingest cycle (IMAP fetch + a handful of DB inserts) finishes in seconds, so SIGTERM
# only needs to wait out whatever cycle is currently in flight, unlike the worker's
# multi-minute extraction jobs.
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
