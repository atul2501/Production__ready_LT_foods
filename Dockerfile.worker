FROM python:3.11-slim

WORKDIR /srv

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app

# With Ollama Cloud as the extraction engine, each job spends nearly all its time blocked
# on a network round-trip, not local CPU/GPU compute - so a `threads` pool (one process,
# N threads, releases the GIL during the blocking httpx call) parallelizes cheaply.
# WORKER_CONCURRENCY should match your Ollama Cloud plan's real concurrent-request limit
# (see .env.example) - set it higher than that and the excess just queues/throttles on
# Ollama's side instead of actually running in parallel. If self-hosted Ollama (the
# documented fallback) is ever made primary again, drop this back down to 1: local GPU
# inference genuinely serializes and doesn't benefit from thread concurrency.
CMD ["sh", "-c", "celery -A app.queue.celery_app.celery_app worker --loglevel=INFO --pool=threads --concurrency=${WORKER_CONCURRENCY:-3}"]
