# Native Postgres (installed via `brew install postgresql@16` locally / `apt install
# postgresql` on the actual server, not Docker) - POSTGRES_* used directly by the pg_dump
# backup script (see deploy/systemd/), keep in sync with DATABASE_URL if you change either.
# Generate a real password, don't ship the placeholder.
POSTGRES_USER=invoice
POSTGRES_PASSWORD=change-me-to-a-real-password
POSTGRES_DB=invoices

DATABASE_URL=postgresql+psycopg2://invoice:change-me-to-a-real-password@localhost:5432/invoices

# DEFAULT: Ollama Cloud. Prefer a rolling/family tag with no date suffix (e.g.
# "deepseek-v4.1-flash", not "deepseek-v4-flash:0731") - dated snapshots are what Ollama
# retires first; the undated family tag is what they keep pointed at a current good model
# for longer. This does not make it permanent - no cloud provider guarantees a fixed model
# forever, see the WATCH THIS block below - but it's the more stable choice within cloud.
# Get a model name from https://ollama.com/search?c=cloud (bare name, no ":cloud" suffix,
# for direct API calls) and a key from https://ollama.com/settings/keys.
OLLAMA_HOSTS=https://ollama.com
OLLAMA_MODEL=deepseek-v4.1-flash
OLLAMA_API_KEY=your-key-here
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT_SECONDS=240

# WATCH THIS: when Ollama sends a retirement notice for OLLAMA_MODEL, swap it here (it's
# the only place the model name lives) and restart the worker service - no code changes.
# If you ever want zero vendor-retirement exposure instead, self-hosting is the only setup
# that guarantees that: comment out the block above and uncomment this one instead - runs
# the native `ollama serve` binary (no Docker) on the same server -
# OLLAMA_HOSTS=http://localhost:11434
# OLLAMA_MODEL=gpt-oss:20b
# OLLAMA_API_KEY=

# How many PDFs the worker process handles in parallel (a thread pool within one process -
# see app/worker/runner.py). Match your Ollama Cloud plan's real concurrent-request limit
# (Free: low, Pro: ~3, Max/Team: ~10) - setting it higher just means the excess requests
# queue/throttle on Ollama's side instead of actually running in parallel. Self-hosted
# Ollama should stay at 1 - local GPU inference genuinely serializes.
WORKER_CONCURRENCY=3

# Local dev path (no root needed). On the real server this should be something like
# /var/lib/invoice-service/pdfs, owned by whatever user runs the systemd services.
STORAGE_DIR=./data/pdfs
LOG_FILE=./logs/app.log

# API returns 503 once this many jobs are queued (protects workers from unbounded backlog)
MAX_QUEUE_BACKLOG=5000

# Retention cleanup (app/worker/retention.py, run daily via a systemd timer)
RETENTION_DAYS=30

# Anti-hallucination tuning
GROUNDING_FUZZY_THRESHOLD=90
ARITHMETIC_TOLERANCE_ABS=0.02
ARITHMETIC_TOLERANCE_REL=0.005
OCR_MIN_CONFIDENCE=0.80
DIGITAL_TEXT_MIN_CHARS_PER_PAGE=200

LOG_LEVEL=INFO
