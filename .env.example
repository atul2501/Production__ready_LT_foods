# DEFAULT: Ollama Cloud. Prefer a rolling/family tag with no date suffix (e.g.
# "deepseek-v4.1-flash", not "deepseek-v4-flash:0731") - dated snapshots are what Ollama
# retires first; the undated family tag is what they keep pointed at a current good model
# for longer. This does not make it permanent - no cloud provider guarantees a fixed model
# forever, see the WATCH THIS block below - but it's the more stable choice within cloud.
# Get a model name from https://ollama.com/search?c=cloud (bare name, no ":cloud" suffix,
# for direct API calls) and a key from https://ollama.com/settings/keys.
OLLAMA_HOSTS=https://ollama.com
OLLAMA_MODEL=gemma4:31b
OLLAMA_API_KEY=your-key-here
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT_SECONDS=240

# WATCH THIS: when Ollama sends a retirement notice for OLLAMA_MODEL, swap it here (it's
# the only place the model name lives) and restart the services - no code changes.
# If you ever want zero vendor-retirement exposure instead, self-hosting is the only setup
# that guarantees that: comment out the block above and uncomment this one instead - runs
# the native `ollama serve` binary (no Docker) on the same server -
# OLLAMA_HOSTS=http://localhost:11434
# OLLAMA_MODEL=gpt-oss:20b
# OLLAMA_API_KEY=

# Where extracted JSON is kept (pending/, delivered/, failed/ subfolders). Local dev path
# (no root needed). On the real server this should be something like
# /var/lib/invoice-service/pdfs, owned by whatever user runs the systemd services.
STORAGE_DIR=./data/pdfs
LOG_FILE=./logs/app.log

# Anti-hallucination tuning
GROUNDING_FUZZY_THRESHOLD=90
ARITHMETIC_TOLERANCE_ABS=0.02
ARITHMETIC_TOLERANCE_REL=0.005
OCR_MIN_CONFIDENCE=0.80
DIGITAL_TEXT_MIN_CHARS_PER_PAGE=200
# Hard ceiling on one page's OCR call - past this it's raised as OcrTimeoutError (retried
# on the next poll) instead of hanging the email poller indefinitely.
OCR_TIMEOUT_SECONDS=90
# Size of the shared thread pool that OCRs scanned pages in parallel (across all PDFs, not
# per PDF) - bounds how many PaddleOCR instances are ever loaded at once. Tune to CPU cores.
OCR_PAGE_WORKERS=4

LOG_LEVEL=INFO

# Email ingestion (IMAP) - app/email_ingest/, runs as its own service (email_ingest_main.py).
# Every PDF attached to an unread message is extracted to STORAGE_DIR/pending/ and handed
# out once by GET /api/v1/invoices/new. The email is marked read once all its PDFs are done.
# For Gmail/Yahoo/Outlook.com with 2FA enabled, this must be an app password, not the
# regular account password.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_USERNAME=invoices@example.com
IMAP_PASSWORD=change-me-to-a-real-app-password
IMAP_FOLDER=INBOX
# Uncomment to move fully-ingested messages here instead of just marking them Seen.
# IMAP_PROCESSED_FOLDER=Processed
IMAP_POLL_INTERVAL_SECONDS=60
# A PDF that fails extraction is retried on this many polls (email stays unread), then a
# "failed" result is handed out and the email is marked read.
EMAIL_MAX_ATTEMPTS=3
# Socket timeout for the IMAP connection - a dropped connection fails the cycle (and is
# retried next poll) instead of hanging the ingester.
IMAP_TIMEOUT_SECONDS=30

