# Native Postgres (installed via `brew install postgresql@16` / `apt install postgresql`
# on the actual server) - POSTGRES_* used directly by the pg_dump backup script, keep in
# sync with DATABASE_URL if you change either.
POSTGRES_USER=invoice
POSTGRES_PASSWORD=1BhDNAjj3FV4hltJnwf3eVOhG9WTR8Uy
POSTGRES_DB=invoices

DATABASE_URL=postgresql+psycopg2://invoice:1BhDNAjj3FV4hltJnwf3eVOhG9WTR8Uy@localhost:5432/invoices

# Ollama Cloud - deepseek-v4.1-flash: newest "flash" (speed-optimized) tier model on
# Ollama Cloud as of 2026-09-19, chosen for the accuracy/speed balance over both the
# smaller gpt-oss:120b and the much larger flagship (glm-5.1/kimi-k3, 900GB-1.5TB) models.
# NOTE: direct HTTP API calls to ollama.com use the bare model name, no ":cloud" suffix.
OLLAMA_HOSTS=https://ollama.com
OLLAMA_MODEL=gemma4:31b
OLLAMA_API_KEY=14bc15bb3f0f4ea9ac77c5d2f05d7584.LactmZLrawDuVlbTU0YTaqyn
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT_SECONDS=240

# Local dev path (no root needed). On the real server this should be something like
# /var/lib/invoice-service/pdfs, owned by whatever user runs the systemd services.
STORAGE_DIR=/Users/atul2501/Desktop/Production_level_Lt/Production__ready_LT_foods/data/pdfs
LOG_FILE=/Users/atul2501/Desktop/Production_level_Lt/Production__ready_LT_foods/logs/app.log

# API returns 503 once this many jobs are queued (protects workers from unbounded backlog)
MAX_QUEUE_BACKLOG=5000

# Postgres-backed queue (app/worker/) - how many PDFs the worker process handles in
# parallel via a thread pool (was previously a Docker Compose --scale/env-var concern,
# now a real app setting). Match your Ollama Cloud plan's real concurrent-request limit
# (Free: low, Pro: ~3, Max/Team: ~10).
WORKER_CONCURRENCY=3

# Anti-hallucination tuning
GROUNDING_FUZZY_THRESHOLD=90
ARITHMETIC_TOLERANCE_ABS=0.02
ARITHMETIC_TOLERANCE_REL=0.005
OCR_MIN_CONFIDENCE=0.80
DIGITAL_TEXT_MIN_CHARS_PER_PAGE=200
# Hard ceiling on one page's OCR call - past this it's raised as OcrTimeoutError (failed,
# eligible for automatic retry) instead of tying up a worker thread indefinitely.
OCR_TIMEOUT_SECONDS=90
# Size of the shared thread pool that OCRs scanned pages in parallel (across all jobs, not
# per job) - bounds how many PaddleOCR instances are ever loaded at once. Tune to CPU cores.
OCR_PAGE_WORKERS=4

LOG_LEVEL=INFO